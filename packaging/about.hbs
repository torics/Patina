<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Patina third-party notices</title>
<style>
body { font: 15px/1.5 system-ui, sans-serif; max-width: 60rem; margin: 2rem auto; padding: 0 1rem; color: #222; }
pre { white-space: pre-wrap; background: #f6f6f6; padding: 1rem; border-radius: 6px; font-size: 13px; }
li { margin: .1rem 0; }
</style>
</head>
<body>
<h1>Third-party notices</h1>
<p>Patina is built from the Rust crates listed here, under the licenses that follow. The packages bundled in the web interface (Preact, CodeMirror and Lezer) are listed with their licenses in THIRD_PARTY_NOTICES_UI.txt.</p>
<h2>Licenses used</h2>
<ul>
{{#each overview}}<li><a href="#{{id}}">{{name}}</a> ({{count}})</li>
{{/each}}
</ul>
{{#each licenses}}
<h2 id="{{id}}">{{name}}</h2>
<p>Used by:</p>
<ul>
{{#each used_by}}<li>{{crate.name}} {{crate.version}}</li>
{{/each}}
</ul>
<pre>{{text}}</pre>
{{/each}}
</body>
</html>
